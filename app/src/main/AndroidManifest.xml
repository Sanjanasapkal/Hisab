<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for Node.js REST API and MongoDB cloud sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hisab">

        <!-- Launch Splash Screen with Hisab Logo -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Hisab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 1: Home Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <!-- Authentication Screens -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.VerifyOtpActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.ForgotUsernameActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.ResetPasswordActivity"
            android:exported="true"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="hisab"
                    android:host="reset-password" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Person Account Details -->
        <activity
            android:name=".PersonDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Add Transaction Form -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 4: Transaction History -->
        <activity
            android:name=".TransactionHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Hisab" />

        <!-- FileProvider for In-App APK Updates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>