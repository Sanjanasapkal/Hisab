<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dark_green"
            app:elevation="2dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvHeaderPersonName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/btnBack"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="Sakshi" />

                    <!-- Action: Edit Name -->
                    <ImageView
                        android:id="@+id/btnEditPerson"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/btnDeletePerson"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Edit person name"
                        android:padding="9dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />

                    <!-- Action: Delete Person -->
                    <ImageView
                        android:id="@+id/btnDeletePerson"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Delete person"
                        android:padding="9dp"
                        android:src="@drawable/ic_delete"
                        app:tint="#FFB4B4" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Balance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/current_balance_label"
                            android:textColor="@color/secondary_text"
                            android:textSize="13sp" />

                        <!-- Large Balance Number -->
                        <TextView
                            android:id="@+id/tvCurrentBalanceAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/positive_balance"
                            android:textSize="32sp"
                            tools:text="+₹190.00" />

                        <!-- Explanatory Badge -->
                        <TextView
                            android:id="@+id/tvBalanceExplanationBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_badge_positive"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:textColor="@color/positive_balance"
                            android:textSize="13sp"
                            tools:text="Sakshi owes you ₹190.00" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/divider" />

                        <!-- Action Buttons Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Add Transaction Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddTransaction"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="8dp"
                                android:backgroundTint="@color/primary_green"
                                android:text="@string/btn_add_transaction"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/white" />

                            <View
                                android:layout_width="8dp"
                                android:layout_height="0dp" />

                            <!-- Settle Hisab Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSettleHisab"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="8dp"
                                android:strokeColor="@color/primary_green"
                                app:strokeWidth="1.5dp"
                                android:text="@string/btn_settle_hisab"
                                android:textColor="@color/primary_green"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_check_circle"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/primary_green" />
                        </LinearLayout>

                        <!-- View History Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewHistory"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:text="@string/btn_view_history"
                            android:textColor="@color/secondary_text"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_history"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:iconTint="@color/secondary_text" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Transactions Section Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvTransactionsHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/current_transactions"
                        android:textColor="@color/main_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTransactionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/secondary_text"
                        android:textSize="13sp"
                        tools:text="2 entries" />
                </RelativeLayout>

                <!-- Transactions RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_transaction" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_avatar">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history"
                            app:tint="@color/primary_green" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/empty_transactions_title"
                        android:textColor="@color/main_text"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/empty_transactions_subtitle"
                        android:textColor="@color/secondary_text"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
