# ==============================================================================
# HISAB BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the `backend/` directory:
#      cp .env.example .env
# 2. Fill in your actual values locally in `.env`.
# 3. NEVER commit your actual `.env` file or any real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/hisab?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. JWT Authentication Security
# ------------------------------------------------------------------------------
# Use a strong, cryptographically secure random string (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Web Application Base URL
# ------------------------------------------------------------------------------
# Used to construct password-reset links sent in emails:
# - For local Android Emulator access: http://10.0.2.2:5000
# - For physical Android Device on Wi-Fi: http://<YOUR_PC_LAN_IP>:5000 (e.g., http://192.168.1.100:5000)
# - For local browser testing: http://localhost:5000
APP_BASE_URL=http://localhost:5000

# ==============================================================================
# 5. REAL EMAIL PROVIDER CONFIGURATION
# ==============================================================================
# Real email delivery is required for 6-digit registration OTP codes, username
# recovery, and password reset links. Choose ONE of the options below.
#
# ------------------------------------------------------------------------------
# OPTION A (RECOMMENDED): Brevo (Formerly Sendinblue) - Free 300 emails/day
# ------------------------------------------------------------------------------
# 1. Sign up at https://app.brevo.com (Free, no credit card required)
# 2. Verify your sender email address under "Senders, Domains & Dedicated IPs"
# 3. Go to "Transactional" -> "Email" -> "Settings" -> "Configuration"
#    (or click your profile -> "SMTP & API" -> "SMTP")
# 4. Fill in:
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your_brevo_account_login_email@example.com
#    SMTP_PASS=xsmtpsib-your_brevo_master_smtp_key
#    EMAIL_FROM="Hisab Support <your_verified_sender@example.com>"
#
# ------------------------------------------------------------------------------
# OPTION B: Gmail SMTP (Google App Password) - Great for quick university demos
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": Search for "App Passwords" in your Google account settings.
# 3. Select app name "Hisab Backend" and copy the 16-character generated password.
# 4. Fill in:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your_personal_email@gmail.com
#    SMTP_PASS=your_16_character_app_password_without_spaces
#    EMAIL_FROM="Hisab Support <your_personal_email@gmail.com>"
#
# ------------------------------------------------------------------------------
# OPTION C: Resend REST API - Modern Developer Email (Free 3,000 emails/month)
# ------------------------------------------------------------------------------
# 1. Sign up at https://resend.com
# 2. Go to "API Keys" -> Click "Create API Key" (Permission: Full Access)
# 3. For immediate testing before domain verification, you can send to your own
#    Resend registered email using sender: EMAIL_FROM="Hisab <onboarding@resend.dev>"
# 4. Fill in:
#    RESEND_API_KEY=re_your_resend_api_key_here
#    EMAIL_FROM="Hisab Support <onboarding@resend.dev>"
#
# ------------------------------------------------------------------------------
# OPTION D: Standard SMTP (SendGrid, Mailgun, Amazon SES, Postmark, Mailtrap)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hisab Support <no-reply@yourdomain.com>"

# Optional Resend API Key (leave blank if using SMTP)
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 6. Development Explicit Mock Mode (OFFLINE ONLY)
# ------------------------------------------------------------------------------
# Set to 'true' ONLY if you want to test locally offline without internet or credentials.
# When true, the backend will print OTPs and reset links to your terminal.
# NOTE: This is strictly BLOCKED in production (NODE_ENV=production).
# In production, missing credentials or ENABLE_MOCK_EMAIL=true will abort startup.
ENABLE_MOCK_EMAIL=false
